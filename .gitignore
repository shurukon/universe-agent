# Secrets and local credentials
.env
.env.*
*.pem
*.key
*.p12
*token*
*credential*
# design token docs are not secrets (the *token* rule catches credential
# files; this keeps the palette source of truth in the repo)
!docs/zcode-tokens.md

# Runtime databases, logs, and local state
*.db
*.sqlite
*.sqlite3
*.jsonl
*.log

# Python and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Generated benchmark/runtime directories
tmp/
frames/
output/
probe_artifacts/
project/

# Node/build artifacts
node_modules/
dist/
build/
coverage/

# OS/editor files
.DS_Store
.vscode/
.idea/
release/

# Agent plan folders (local session artifacts)
.zcode/
.kilo/

# Stale build output that should never ship
dist-electron/main.js

# Memory snapshot exports (generated at runtime; the live source is /api/memory)
universe-memory.json

test_file.txt

# local captures & one-off artifacts (never publish)
*.png
!universe-agent-ui/client/public/*.png
!universe-agent-ui/build/*.png
*.jpg
*.jpeg
*.webp
*.mp4
*.webm

# Dev leftovers in the repo root (never tracked). Several are already
# covered by the generic *.log / *.png rules above; they are repeated
# here so the intent is explicit and does not depend on rule order.
payload.txt
debug.log
.vite_manual.log
pytest_*.log
pw_probe_*.js
shot.png
tmp_screens/
.tooltest/

# Root-level npm manifests are local scaffolding only — the real client
# package lives in universe-agent-ui/ and MUST stay tracked.
# (anchored with a leading slash so the UI manifests are unaffected)
/package.json
/package-lock.json

# The session archive (audit 2026-11-11): every session's durable event log
# lives in <project>/sessions/<session_id>/events.jsonl — inside the project
# the user works in, by design. When that project IS the repo, the folder
# must never be committed.
/sessions/
