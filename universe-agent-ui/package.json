{
  "name": "universe-agent-ui",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "preview": "vite preview --host",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json && eslint client/src",
    "format": "prettier --write .",
    "build": "npm run check && npm run build:electron && vite build",
    "build:electron": "esbuild electron/main.ts --platform=node --packages=external --bundle --format=esm --outfile=dist-electron/main.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; import { fileURLToPath as __f2p } from 'node:url'; import * as __p from 'node:path'; const require = __cr(import.meta.url); const __dirname = __p.dirname(__f2p(import.meta.url));\" && esbuild electron/preload.ts --platform=node --packages=external --bundle --format=cjs --outfile=dist-electron/preload.js",
    "desktop": "concurrently -k --kill-others-on-fail \"npm:dev:client:desktop\" \"npm:electron:dev\"",
    "dev:client:desktop": "vite --port 5199 --strictPort",
    "electron:dev": "wait-on -t 60000 http://127.0.0.1:5199 && electron .",
    "desktop:prod": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.0",
    "axios": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.5",
    "next-themes": "^0.4.6",
    "postprocessing": "^6.39.4",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.64.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "streamdown": "^1.4.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.0",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.7",
    "vitest": "^2.1.4",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "tailwindcss": { "nanoid": "3.3.7" }
  },
  "main": "dist-electron/main.mjs",
  "description": "Universe Agent — the desktop app. Local-first AI agent OS with a living memory universe.",
  "author": {
    "name": "Universe Agent"
  }
}
